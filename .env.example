GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
# Writer (research, assignments, slides): strong, cheap, long output
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Fast (chat in Egyptian Arabic, understanding, reading images for Mirror)
OPENROUTER_FAST_MODEL=google/gemini-3.6-flash
VISION_MODEL=google/gemini-3.6-flash
# Designer (PowerPoint slides with drawings): best design quality. Cheaper option: google/gemini-3.6-flash
OPENROUTER_DESIGN_MODEL=anthropic/claude-sonnet-5.5
# Offline test mode only. NEVER true in production.
MIA_MOCK_AI=false
OPENROUTER_ENABLED=true
OWNER_PAID_ENABLED=true
# Without Supabase: skip the durable ledger. Set a monthly spending limit on the OpenRouter key itself.
PAID_LEDGER_OPTIONAL=true
PAID_GLOBAL_CAP_USD=20
ALLOW_LOCAL_MODE=true
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NCBI_API_KEY=
AI_REQUESTS_PER_DAY=30
REQUESTS_PER_HOUR=400
APP_ORIGIN=

# Sites-only: trust authenticated identity injected by the hosting platform.
SITES_AUTH_ENABLED=false
PAID_MAX_OPERATION_USD=0.25

# Daily limits per student (0 = unlimited). Run database/v6_quota.sql on Supabase.
DAILY_RESEARCH_LIMIT=5
DAILY_DECK_LIMIT=5
DAILY_EDIT_LIMIT=60
